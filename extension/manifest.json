{
  "manifest_version": 3,
  "name": "排班工作台助手",
  "version": "0.6.0",
  "description": "一键查看今日班次、待办与逾期提醒（工具栏角标），支持网页端快捷跳转与任务勾选完成。服务器地址可在弹窗内设置，更换域名无需重装。",
  "permissions": ["storage", "tabs", "activeTab", "alarms", "notifications"],
  "host_permissions": ["<all_urls>"],
  "externally_connectable": {
    "matches": ["http://localhost:8080/*"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "排班工作台助手"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
